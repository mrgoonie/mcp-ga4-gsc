/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcp-ga4-gsc",
  "main": "src/index.ts",
  "account_id": "009dc0fcd0da3e503fbf38eb2b586e4b",
  "compatibility_date": "2025-03-10",
  "compatibility_flags": ["nodejs_compat"],
  // ALLOWED_EMAILS, ALLOWED_DOMAINS and ALIAS_PATHS are set as secrets
  // (npx wrangler secret put NAME) or via the Cloudflare dashboard,
  // so they do not appear in this committed file.
  // See MULTI-ACCOUNT.md and DEPLOY.md for setup instructions.
  "migrations": [
    {
      "new_sqlite_classes": ["MyMCP"],
      "tag": "v1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "MyMCP",
        "name": "MCP_OBJECT"
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "fbaf932f941341d3b48e164083dce8b0"
    }
  ],
  "observability": {
    "enabled": true
  },
  "dev": {
    "port": 8788
  }
}
